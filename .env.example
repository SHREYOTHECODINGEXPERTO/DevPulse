# DevPulse REST API & Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# Persistent Database Configuration
# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# SECURITY NOTE: Never commit production credentials or password-containing URIs to Git.
# Set MONGODB_URI via your environment secrets or CI/CD pipeline.
MONGODB_URI=mongodb://127.0.0.1:27017/devpulse

# Database Options
DB_NAME=devpulse
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# Persistent Document Storage File (Fallback Engine)
STORAGE_FILE=./server/data/db.json
